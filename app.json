{
  "expo": {
    "name": "Anatomi Rehberi",
    "slug": "anatomi-rehberi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digituva.anatomi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D6457A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.digituva.anatomi",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF8FA"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# expo-gl GLView, ExpoView olmadığı için expo-modules-core kuralları yapıcılarını korumuyor;\n# R8 silince Vücut Haritası açılırken uygulama çöküyor.\n-keep class expo.modules.gl.** { *; }"
          }
        }
      ]
    ],
    "scheme": "anatomi",
    "description": "Ebelik, hemşirelik ve sağlık bilimleri öğrencileri için 3D anatomi, konu anlatımı, bilgi kartları ve testler.",
    "extra": {
      "eas": {
        "projectId": "21dd7007-78cd-4938-bc17-3398cb55c3a6"
      }
    },
    "owner": "karmaozdemir"
  }
}
